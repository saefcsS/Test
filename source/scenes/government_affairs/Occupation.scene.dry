    var paths = container.querySelectorAll("path[id]");
    var self = this;
    paths.forEach(function(path) {
        var stateId = path.id;
        self.paths[stateId] = path;
        if (stateId === "Outline") return;
        path.addEventListener("click", function() {
            window.dendryUI.dendryEngine.goToScene("Occupation." + stateId + "_posture");
        });
    });

    this.recolor();
  }
};

DixieOccupationMap.draw({ container: "#Dixie-map" }, {
    AL: { posture: Q.AL_occupation_posture, danger: (Q.AL_kkk_strength||0) + (Q.AL_whiteL_strength||0) },
    AR: { posture: Q.AR_occupation_posture, danger: (Q.AR_kkk_strength||0) + (Q.AR_whiteL_strength||0) },
