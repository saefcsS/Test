title: Southern Occupation
on-arrival: month_actions += 1
view-if: rep_majority = 1 and occupation >= 1
card-image: img/Occupation.jpg
is-card: true
new-page: true
tags: cotus_affairs, cabinet
on-display: {!

window.DixieOccupationMap = {
  paths: {},
  data: {},
  mode: 'posture',

  postureColor: function(stateId) {
    var p = this.data[stateId].posture;
    return p === 2 ? '#2c3e6b' : (p === 1 ? '#c9a24b' : '#d9d9d9');
  },

  dangerColor: function(stateId) {
    var d = this.data[stateId].danger; // kkk_strength + whiteL_strength
    if (d >= 100) return '#8b1a1a';
    if (d >= 60)  return '#c76b2e';
    if (d >= 30)  return '#d4b23c';
    if (d >= 10)  return '#8fae4a';
    return '#4a7c3c';
  },

  recolor: function() {
    var colorFn = this.mode === 'danger' ? this.dangerColor : this.postureColor;
    for (var id in this.paths) {
      if (id === 'Outline') continue;
      this.paths[id].style.fill = colorFn.call(this, id);
    }
  },

  setMode: function(mode) {
    this.mode = mode;
    this.recolor();
    var buttons = document.querySelectorAll('.map-btn');
    buttons.forEach(function(btn) {
        if (btn.getAttribute('data-mode') === mode) {
            btn.classList.add('active')
        } else {
            btn.classList.remove('active')
        }
    });
  },

  draw: function(opts, stateData) {
    this.data = stateData;
    var container = document.querySelector(opts.container);
    if (!container) return;
    container.innerHTML = `
      <svg version="1.2"
           viewBox="0 0 284 184"
           width="284"
           height="184"
           id="svg1"
           xmlns="http://www.w3.org/2000/svg"
           xmlns:svg="http://www.w3.org/2000/svg">

        <style>
          .s1 {
            fill: none;
            stroke: #000000;
            stroke-width: .5;
          }

          .s0 {
            cursor: pointer;
            transition: opacity 0.15s ease;
          }

          .s0:hover {
            opacity: 0.7;
          }
        </style>

