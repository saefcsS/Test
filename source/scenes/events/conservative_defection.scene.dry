title: The Conservative Republican Defection
subtitle: The party's right flank walks out.
tags: event
new-page: true
view-if: conservative_strength >= 15 and conservative_dissent >= 25 and conservative_defection = 0 and year >= 1866
max-visits: 1

= The Conservative Republican Defection

The tensions within the <span style="color: #c00000;">**Republican Party**</span> have finally reached a breaking point, this time from the opposite direction. A faction of the party's most committed conservatives, veterans, businessmen, and border-state moderates who backed the war and the Union but never much cared for military Reconstruction or radical experiments in the South, has decided it can no longer work within the regular organization.

[? if radical_strength >= 40 : The **<span style="color: #7A1F5C;">Radical</span>** wing's growing influence over party policy has been the final straw. These conservatives see continued military enforcement, sweeping civil rights guarantees, and open hostility to the South's old leadership as a betrayal of the Union the war was supposed to restore, not remake. ?]

[? if radical_strength < 40 : Even without a strong Radical faction to blame, these conservatives remain convinced that the party has grown too entangled with federal power, too indulgent of corruption, and too unwilling to let the South govern its own affairs again. ?]

They have broken away, some crossing the floor to the <span style="color: #0015bc;">**Democratic Party**</span> outright, others declaring themselves independent rather than answer to a party they no longer recognize. Sympathetic newspapers and business circles across the North and border states have already begun treating the break as settled fact.

- @accept_defection: Accept the defection and focus on consolidating the remaining party.
- @reach_out: Attempt to bring the conservatives back into the fold.
- @condemn: Condemn the defectors publicly.

@accept_defection
on-arrival: {!

    // Each class bleeds a share of Republican support proportional to
    // conservative_strength itself, scaled by how aligned that class is
    // with the conservative cause. Middle-class and rural voters, the
    // conservatives' strongest base, bleed well above average; freedmen
    // and immigrant laborers barely move.
    let classMultiplier = {
        workers: 0.2,
        middle_class: 1.4,
        rural: 0.8,
        freemen: 0.05,
        immigrant_laborers: 0.15,
        unemployed: 0.1
    };

    let splitIntensity = 1.0; // clean, uncontested break
    let conFraction = (Q.conservative_strength || 0) / 100;

    function clamp(x) {
        return Math.max(0, Math.min(0.9, x));
    }

    let classes = Q.classes;

    for (let cls of classes) {
        let mult = classMultiplier[cls] || 0.3;
        let bleed = clamp(conFraction * mult * splitIntensity);
        let transfer = Math.round(Q[cls + '_rep'] * bleed);
        Q[cls + '_rep'] -= transfer;
        Q[cls + '_dem'] = (Q[cls + '_dem'] || 0) + transfer;
    }

    for (let state of Q.states) {
        for (let cls of classes) {
            let mult = classMultiplier[cls] || 0.3;
            let bleed = clamp(conFraction * mult * splitIntensity);
            let stateKey = state + '_' + cls + '_rep';
            let demKey = state + '_' + cls + '_dem';
            let transfer = Math.round((Q[stateKey] || 0) * bleed);
            Q[stateKey] -= transfer;
            Q[demKey] = (Q[demKey] || 0) + transfer;
        }
    }

    Q.conservative_defectors_house = Math.round(Q.rep_r * conFraction * splitIntensity);
    Q.rep_r -= Q.conservative_defectors_house;
    Q.dem_r += Q.conservative_defectors_house;
    Q.conservative_defectors_senate = Math.round(Q.rep_senate_r * conFraction * splitIntensity);
    Q.rep_senate_r -= Q.conservative_defectors_senate;
    Q.dem_senate_r += Q.conservative_defectors_senate;

    Q.conservative_defection = 1;
    Q.conservative_strength = 0;
    Q.conservative_dissent = 0;
    Q.radical_dissent -= 5;
    Q.moderate_dissent -= 2;
    Q.dem_reform_strength += 4;

    let totalHouse = Q.rep_r + Q.dem_r + Q.lib_r + Q.rad_r + Q.other_r;
    let repPct = (Q.rep_r / totalHouse) * 100;
    if (repPct >= 66.7) {
        Q.house_majority = 3;
    } else if (repPct >= 50) {
        Q.house_majority = 2;
    } else {
        Q.house_majority = 0;
    }

!}

A painful but perhaps inevitable rupture. The conservative wing departs with [+ conservative_defectors_house +] House seats and [+ conservative_defectors_senate +] Senate seats, most of them crossing straight to the <span style="color: #0015bc;">**Democrats**</span>. Their appeal was strongest among the middle class and rural, business-minded voters who never fully trusted federal enforcement in the South.

Without them, the party is more ideologically coherent and easier to govern, but it has lost its most reliable defenders against charges of radicalism.

@reach_out
subtitle: -2 resources
choose-if: resources >= 2
unavailable-subtitle: Not enough resources.
on-arrival: {!

    let classMultiplier = {
        workers: 0.2,
        middle_class: 1.4,
        rural: 0.8,
        freemen: 0.05,
        immigrant_laborers: 0.15,
        unemployed: 0.1
    };

    let splitIntensity = 0.5; // outreach softens the break
    let conFraction = (Q.conservative_strength || 0) / 100;

    function clamp(x) {
        return Math.max(0, Math.min(0.9, x));
    }

    let classes = Q.classes;

    for (let cls of classes) {
        let mult = classMultiplier[cls] || 0.3;
        let bleed = clamp(conFraction * mult * splitIntensity);
        let transfer = Math.round(Q[cls + '_rep'] * bleed);
        Q[cls + '_rep'] -= transfer;
        Q[cls + '_dem'] = (Q[cls + '_dem'] || 0) + transfer;
    }

    for (let state of Q.states) {
        for (let cls of classes) {
            let mult = classMultiplier[cls] || 0.3;
            let bleed = clamp(conFraction * mult * splitIntensity);
            let stateKey = state + '_' + cls + '_rep';
            let demKey = state + '_' + cls + '_dem';
            let transfer = Math.round((Q[stateKey] || 0) * bleed);
            Q[stateKey] -= transfer;
            Q[demKey] = (Q[demKey] || 0) + transfer;
        }
    }

    Q.conservative_defectors_house = Math.round(Q.rep_r * conFraction * splitIntensity);
    Q.rep_r -= Q.conservative_defectors_house;
    Q.dem_r += Q.conservative_defectors_house;
    Q.conservative_defectors_senate = Math.round(Q.rep_senate_r * conFraction * splitIntensity);
    Q.rep_senate_r -= Q.conservative_defectors_senate;
    Q.dem_senate_r += Q.conservative_defectors_senate;

    Q.resources -= 2;
    Q.conservative_defection = 1;
    Q.conservative_strength = Math.round(Q.conservative_strength * 0.4);
    Q.conservative_dissent -= 10;
    Q.radical_dissent += 3;
    Q.moderate_dissent -= 2;

    let totalHouse = Q.rep_r + Q.dem_r + Q.lib_r + Q.rad_r + Q.other_r;
    let repPct = (Q.rep_r / totalHouse) * 100;
    if (repPct >= 66.7) {
        Q.house_majority = 3;
    } else if (repPct >= 50) {
        Q.house_majority = 2;
    } else {
        Q.house_majority = 0;
    }
!}

Our outreach keeps some conservatives in the fold, but the defection still happens. A smaller conservative bloc departs with [+ conservative_defectors_house +] House seats, taking some of our steadiest business-class support with them.

The conservatives who remain are mollified for now, but their patience with the party's direction remains thin.

@condemn
on-arrival: {!

    let classMultiplier = {
        workers: 0.2,
        middle_class: 1.4,
        rural: 0.8,
        freemen: 0.05,
        immigrant_laborers: 0.15,
        unemployed: 0.1
    };

    let splitIntensity = 1.3; // public condemnation drives out even the wavering
    let conFraction = (Q.conservative_strength || 0) / 100;

    function clamp(x) {
        return Math.max(0, Math.min(0.9, x));
    }

    let classes = Q.classes;

    for (let cls of classes) {
        let mult = classMultiplier[cls] || 0.3;
        let bleed = clamp(conFraction * mult * splitIntensity);
        let transfer = Math.round(Q[cls + '_rep'] * bleed);
        Q[cls + '_rep'] -= transfer;
        Q[cls + '_dem'] = (Q[cls + '_dem'] || 0) + transfer;
    }

    for (let state of Q.states) {
        for (let cls of classes) {
            let mult = classMultiplier[cls] || 0.3;
            let bleed = clamp(conFraction * mult * splitIntensity);
            let stateKey = state + '_' + cls + '_rep';
            let demKey = state + '_' + cls + '_dem';
            let transfer = Math.round((Q[stateKey] || 0) * bleed);
            Q[stateKey] -= transfer;
            Q[demKey] = (Q[demKey] || 0) + transfer;
        }
    }

    Q.conservative_defectors_house = Math.round(Q.rep_r * conFraction * splitIntensity);
    Q.rep_r -= Q.conservative_defectors_house;
    Q.dem_r += Q.conservative_defectors_house;
    Q.conservative_defectors_senate = Math.round(Q.rep_senate_r * conFraction * splitIntensity);
    Q.rep_senate_r -= Q.conservative_defectors_senate;
    Q.dem_senate_r += Q.conservative_defectors_senate;

    Q.conservative_defection = 1;
    Q.conservative_strength = 0;
    Q.conservative_dissent = 0;
    Q.radical_dissent -= 8;
    Q.moderate_dissent += 3;
    Q.dem_reform_strength += 8;
    Q.dem_relation += 5;

    let totalHouse = Q.rep_r + Q.dem_r + Q.lib_r + Q.rad_r + Q.other_r;
    let repPct = (Q.rep_r / totalHouse) * 100;
    if (repPct >= 66.7) {
        Q.house_majority = 3;
    } else if (repPct >= 50) {
        Q.house_majority = 2;
    } else {
        Q.house_majority = 0;
    }
!}

Our condemnation only hardens their resolve. The conservative wing departs with [+ conservative_defectors_house +] House seats and [+ conservative_defectors_senate +] Senate seats more than they might have taken otherwise, nearly all of them crossing straight to the <span style="color: #0015bc;">**Democrats**</span>.

<span style="color: #0015bc;">**Democrats**</span> are pleased to see the party's conservative wing cast out and warmly welcome its defectors. But we have made enemies of men who were, until recently, our most reliable check on the party's radical impulses.