title: Southern State Elections
subtitle: In the land of Cotton
tags: event
view-if: year = 1865 and month = 12
max-visits: 1

= Elections, [+ month +] [+ year +]

Seven Southern states hold their first elections since the collapse of the rebellion. With the old political order broken, Unionists seek to rebuild within the restored Union while Conservatives, drawn largely from the planter class and former Confederates, move to reclaim control over Southern affairs.

President Johnson's lenient Reconstruction has returned civilian government to the South remarkably quickly. Freedmen remain barred from the ballot, while pardoned Confederates return to public office across the region. Whether these elections mark genuine reunion or the restoration of the old order will be decided in Washington.

- @Dixie: Lets see the results

@Dixie
on-arrival: {!

let dixie1865 = {
  TN: {
    gub: { winner: "rep", margin: 99, contested: false },
    leg: { winner: "rep", margin: 95, contested: false, seats: 75 },
  },
  GA: {
    gub: { winner: "dem", margin: 97, contested: false },
    leg: { winner: "dem", margin: 90, contested: false, seats: 175 },
  },
  LA: {
    gub: { winner: "rep", margin: 95, contested: false },
    leg: { winner: "dem", margin: 80, contested: false, seats: 105 },
  },
  SC: {
    gub: { winner: "rep", margin: 4,  contested: true },
    leg: { winner: "rep", margin: 8,  contested: true, seats: 124 },
  },
  NC: {
    gub: { winner: "rep", margin: 12, contested: true },
    leg: { winner: "dem", margin: 40, contested: true, seats: 170 },
  },
  AL: {
    gub: { winner: "rep", margin: 10, contested: true },
    leg: { winner: "rep", margin: 5,  contested: true, seats: 100 },
  },
  MS: {
    gub: { winner: "dem", margin: 15, contested: true },
    leg: { winner: "dem", margin: 25, contested: true, seats: 115 },
  },
};

let partyLabel = { rep: "Unionist", dem: "Conservative" };

let baselineRep = 55;
let baselineDem = 42;
let nationalRepSwing = (Q.workers_rep + Q.middle_class_rep + Q.rural_rep + Q.freemen_rep) / 4 - baselineRep;
nationalRepSwing = Math.max(-6, Math.min(6, nationalRepSwing));

function resolveRace(race) {
  let floorMargin = race.contested ? race.margin : Math.max(80, race.margin - Math.abs(nationalRepSwing) * 2);
  let adjMargin = floorMargin;
  if (race.contested) {
    adjMargin += nationalRepSwing * (race.winner === "rep" ? 1 : -1);
    adjMargin += (Math.random() * 10) - 5;
    adjMargin = Math.max(0.5, adjMargin);
  }
  let repShare = race.winner === "rep" ? 50 + adjMargin / 2 : 50 - adjMargin / 2;
  let demShare = 100 - repShare;
  let finalWinner = repShare >= demShare ? "rep" : "dem";
  return { repShare: repShare, demShare: demShare, winner: finalWinner };
}

for (let state in dixie1865) {
  let data = dixie1865[state];

  let gubResult = resolveRace(data.gub);
  Q[state + "_gub_winner"] = gubResult.winner;
  Q[state + "_gub_rep_pct"] = gubResult.repShare.toFixed(1);
  Q[state + "_gub_dem_pct"] = gubResult.demShare.toFixed(1);

  let legResult = resolveRace(data.leg);
  let repSeats = Math.round(data.leg.seats * (legResult.repShare / 100));
  let demSeats = data.leg.seats - repSeats;

  Q[state + "_leg_winner"] = legResult.winner;
  Q[state + "_leg_rep_seats"] = repSeats;
  Q[state + "_leg_dem_seats"] = demSeats;
  Q[state + "_leg_total_seats"] = data.leg.seats;
}

!}
on-display: {!

var DixieMap = {
  draw: function(opts) {
    var container = document.querySelector(opts.container);
    if (!container) return;

    var results = opts.results || {};
    var partyColors = Object.assign({ unknown: "#a0a0a0" }, opts.partyColors || {});
    var partyLabel = opts.partyLabel || { rep: "Rep", dem: "Dem" };

