        </svg>
        <div id="dixie-tooltip" class="dixie-tooltip">
          <div class="et-title" id="dixie-tooltip-title"></div>

            <div class="et-section">
              <div class="et-subtitle">Governor</div>
              <div class="et-body">
                <svg class="et-pie" id="dixie-gub-pie" width="70" height="70" viewBox="0 0 100 100"></svg>
              <div class="et-results" id="dixie-gub-results"></div>
            </div>
          </div>

          <div class="et-section">
            <div class="et-subtitle">Legislature</div>
              <div class="et-body" id="dixie-leg-parliament-wrap">
                <svg class="et-pie" id="dixie-leg-parliament" width="140" height="70"></svg>
              <div class="et-results" id="dixie-leg-results"></div>
            </div>
          </div>
        </div>
    `;

    var tooltip = container.querySelector("#dixie-tooltip");
    var titleEl = container.querySelector("#dixie-tooltip-title");
    var gubPieSVG = container.querySelector("#dixie-gub-pie");
    var gubResultsEl = container.querySelector("#dixie-gub-results");
    var legParliamentSVG = container.querySelector("#dixie-leg-parliament");
    var legResultsEl = container.querySelector("#dixie-leg-results");

    // --- pie chart for governor's race (kept hand-built; d3-parliament is
    // seat-based and isn't meant for a two-slice pie) ---
    function drawPie(svgEl, repPct, demPct, repColor, demColor) {
      var repDeg = (repPct / 100) * 360;
      function point(deg, r) {
        var rad = (deg - 90) * Math.PI / 180;
        return [50 + r * Math.cos(rad), 50 + r * Math.sin(rad)];
      }
      var p1 = point(0, 45);
      var p2 = point(repDeg, 45);
      var largeArc = repDeg > 180 ? 1 : 0;
      var repPath = "M50,50 L" + p1[0] + "," + p1[1] + " A45,45 0 " + largeArc + " 1 " + p2[0] + "," + p2[1] + " Z";
      var p3 = point(repDeg, 45);
      var p4 = point(360, 45);
      var largeArc2 = (360 - repDeg) > 180 ? 1 : 0;
      var demPath = "M50,50 L" + p3[0] + "," + p3[1] + " A45,45 0 " + largeArc2 + " 1 " + p4[0] + "," + p4[1] + " Z";

      svgEl.innerHTML =
        '<path d="' + repPath + '" fill="' + repColor + '"></path>' +
        '<path d="' + demPath + '" fill="' + demColor + '"></path>';
    }

    // --- legislature seats via d3-parliament.js ---
    function drawParliament(svgEl, repSeats, demSeats, repColor, demColor) {
      var data = [
        { id: "rep", seats: repSeats, color: repColor, outline: "var(--content-bg-color)" },
        { id: "dem", seats: demSeats, color: demColor, outline: "var(--content-bg-color)" },
      ];

      var chart = d3.parliament().width(140);
      chart.update.animate(false);   // no transition lag while hovering between states
      chart.enter.smallToBig(false);
      chart.enter.fromCenter(false);
      chart.exit.bigToSmall(false);
      chart.exit.toCenter(false);

      d3.select(svgEl).datum(data).call(chart);
    }

    function resultRow(label, pctOrSeats, color) {
      return '<div class="et-row"><span class="et-swatch" style="background-color:' + color + ';"></span>' + label + ' ' + pctOrSeats + '</div>';
    }

    var paths = container.querySelectorAll("path[id]");
    paths.forEach(function(path) {
      var stateId = path.id;
      if (stateId === "Outline") return;
      var stateResults = results[stateId];
      var winner = stateResults ? stateResults.gubWinner : null;
      path.style.fill = winner ? partyColors[winner] : partyColors.unknown;

      if (!stateResults) return;

      var repColor = partyColors.rep;
      var demColor = partyColors.dem;

      path.addEventListener("mouseenter", function() {
        titleEl.textContent = stateId;

        drawPie(gubPieSVG, stateResults.gubRepPct, stateResults.gubDemPct, repColor, demColor);
        gubResultsEl.innerHTML =
          resultRow(partyLabel.rep, stateResults.gubRepPct + "%", repColor) +
          resultRow(partyLabel.dem, stateResults.gubDemPct + "%", demColor);

        drawParliament(legParliamentSVG, stateResults.legRepSeats, stateResults.legDemSeats, repColor, demColor);
        legResultsEl.innerHTML =
          resultRow(partyLabel.rep, stateResults.legRepSeats + " seats", repColor) +
          resultRow(partyLabel.dem, stateResults.legDemSeats + " seats", demColor);

        tooltip.style.display = "block";
      });

      path.addEventListener("mousemove", function(e) {
        tooltip.style.left = (e.clientX + 16) + "px";
        tooltip.style.top = (e.clientY + 16) + "px";
      });

      path.addEventListener("mouseleave", function() {
        tooltip.style.display = "none";
      });
    });
  },
};

function drawMap() {
  DixieMap.draw({
    container: "#Dixie-map",
    partyColors: {
      rep: "#B22222", // Unionist
      dem: "#F79500", // Conservative
    },
    partyLabel: { rep: "Unionist", dem: "Conservative" },
    results: {
      TN: { gubWinner: Q.TN_gub_winner, gubRepPct: Q.TN_gub_rep_pct, gubDemPct: Q.TN_gub_dem_pct, legRepSeats: Q.TN_leg_rep_seats, legDemSeats: Q.TN_leg_dem_seats },
      SC: { gubWinner: Q.SC_gub_winner, gubRepPct: Q.SC_gub_rep_pct, gubDemPct: Q.SC_gub_dem_pct, legRepSeats: Q.SC_leg_rep_seats, legDemSeats: Q.SC_leg_dem_seats },
      GA: { gubWinner: Q.GA_gub_winner, gubRepPct: Q.GA_gub_rep_pct, gubDemPct: Q.GA_gub_dem_pct, legRepSeats: Q.GA_leg_rep_seats, legDemSeats: Q.GA_leg_dem_seats },
      AL: { gubWinner: Q.AL_gub_winner, gubRepPct: Q.AL_gub_rep_pct, gubDemPct: Q.AL_gub_dem_pct, legRepSeats: Q.AL_leg_rep_seats, legDemSeats: Q.AL_leg_dem_seats },
      NC: { gubWinner: Q.NC_gub_winner, gubRepPct: Q.NC_gub_rep_pct, gubDemPct: Q.NC_gub_dem_pct, legRepSeats: Q.NC_leg_rep_seats, legDemSeats: Q.NC_leg_dem_seats },
      MS: { gubWinner: Q.MS_gub_winner, gubRepPct: Q.MS_gub_rep_pct, gubDemPct: Q.MS_gub_dem_pct, legRepSeats: Q.MS_leg_rep_seats, legDemSeats: Q.MS_leg_dem_seats },
      LA: { gubWinner: Q.LA_gub_winner, gubRepPct: Q.LA_gub_rep_pct, gubDemPct: Q.LA_gub_dem_pct, legRepSeats: Q.LA_leg_rep_seats, legDemSeats: Q.LA_leg_dem_seats },
    },
  });
}

drawMap();

!}


= DIXIE

