66 l 1.3,0.66 -0.22,1.83 1.95,0.11 1.19,0.54 1.96,0.33 1.18,0.87 1.09,-0.98 1.62,0.33 1.19,1.61 h 0.44 v 1.09 l 1.07,0.33 1.09,-1.09 0.87,0.33 h 1.2 l 0.42,1.19 2.28,0.86 0.64,-0.31 0.87,-1.96 h 0.54 l 0.55,0.98 1.94,0.33 1.74,0.65 1.4,0.43 0.87,-0.43 0.33,-1.2 h 2.06 l 0.97,0.44 1.3,-0.98 h 0.55 l 0.32,0.76 h 1.95 l 0.76,-0.98 0.87,0.22 0.96,1.19 1.52,0.86 1.53,0.43 1.29,0.77 M 42.79,63.23 h -0.8 l -0.77,8.87 -1.85,26.32 -1.08,11.26 -13.74,-0.76 -13.76,-1.3 -3.79,-0.31 0.33,2.37" style="display:inline"/>
